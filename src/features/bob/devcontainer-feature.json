{
  "id": "bob",
  "version": "1.0.0",
  "name": "Bob Shell",
  "description": "Install Bob Shell AI terminal assistant and share its config folder with other agents.",
  "documentationURL": "https://www.npmjs.com/package/@roo-code/bob-shell",
  "license": "MIT",
  "keywords": [
    "bob",
    "ai",
    "assistant",
    "shell"
  ],
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "description": "Version of Bob Shell to install"
    }
  },
  "dependsOn": {
    "ghcr.io/docker-x/devcontainer/agent-config": {}
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils",
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/docker-x/devcontainer/agent-config"
  ]
}
