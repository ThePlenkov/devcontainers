{
  "id": "cline",
  "version": "1.0.0",
  "name": "Cline CLI",
  "description": "Install Cline CLI — an open-source AI coding agent with VS Code extension and terminal CLI support.",
  "documentationURL": "https://github.com/cline/cline",
  "keywords": [
    "ai",
    "cline",
    "agent",
    "cli",
    "coding",
    "open-source"
  ],
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "description": "Version to install"
    },
    "shareConfig": {
      "type": "boolean",
      "default": false,
      "description": "When true, symlink the agent config dir to the shared AGENT_CONFIG_DIR so config persists across container rebuilds and is shared with other agents"
    }
  },
  "dependsOn": {
    "ghcr.io/docker-x/devcontainers/agent-config": {},
    "ghcr.io/devcontainers/features/node": {}
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils",
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/docker-x/devcontainers/agent-config"
  ]
}
